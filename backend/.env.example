# Backend configuration. Copy to the repo-root .env (gitignored) and adjust.
# Values below are safe placeholders — no secrets.

# Path to the persisted vector store exported by the RAG notebook.
VECTOR_STORE_PATH=data/vector_store/chroma

# Embedding model (must match the one used by the notebook index build).
EMBED_MODEL=BAAI/bge-m3

# Where bge-m3 runs. Leave empty for auto (GPU if available); set "cpu" to
# keep a weak GPU for Ollama. Ignored when EMBED_MODEL is empty/TEST.
EMBED_DEVICE=

# Ollama — local LLM entrypoint. The answering model is served by Ollama on
# the same machine as the backend (generation candidates: command-r7b-arabic /
# falcon-h1-arabic-7b, per spec §7).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=command-r7b-arabic

# Answer hygiene: minimum retrieved-context similarity to produce an answer.
# Below this the backend answers "not grounded" instead of hallucinating.
MIN_SCORE=0.35

# Frontend origin(s) allowed by CORS.
CORS_ORIGINS=["http://localhost:8501","http://localhost:8502"]