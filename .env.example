# medical-assistant environment template.
# Copy to .env and fill in real values. This file contains NO secrets —
# every value below is a placeholder that works for local development.

# Corpus location (gitignored; see data/corpus/INVENTORY.md)
DATA_CORPUS_DIR=data/corpus
DATA_VECTOR_STORE_DIR=data/vector_store
DATA_RX_PHOTOS_DIR=data/rx_photos

# Kaggle CLI. The API token is read from $KAGGLE_CONFIG_DIR/access_token.
# Create one at kaggle.com/settings/account -> API -> Create New Token.
KAGGLE_CONFIG_DIR=~/.kaggle

# Backend (used from M3 onward)
BACKEND_URL=http://127.0.0.1:8000